# Modern 64-bit Windows build foundation for rdesktop.
# Invoke from the repository root with a MinGW-w64 x64 toolchain on PATH.

CC = x86_64-w64-mingw32-gcc
POWERSHELL = powershell.exe

TARGET_NAME = win64-modern-mingw64
BUILD_ROOT = build
TARGET_DIR = $(BUILD_ROOT)/$(TARGET_NAME)
OBJ_DIR = $(TARGET_DIR)/obj
BIN_DIR = $(TARGET_DIR)/bin
PACKAGE_DIR = $(TARGET_DIR)/package
TEST_OBJ_DIR = $(OBJ_DIR)/tests
PACKAGE_ZIP = $(PACKAGE_DIR)/rdesktop-$(TARGET_NAME).zip
RUNTIME_DLLS = libbrotlicommon.dll libbrotlidec.dll libbrotlienc.dll libffi-8.dll \
	libgmp-10.dll libgnutls-30.dll libhogweed-7.dll libiconv-2.dll \
	libidn2-0.dll libintl-8.dll libnettle-9.dll libp11-kit-0.dll \
	libtasn1-6.dll libunistring-5.dll libwinpthread-1.dll libzstd.dll zlib1.dll
BIN_RUNTIME_DLLS = $(addprefix $(BIN_DIR)/,$(RUNTIME_DLLS))

VERSION = 1.9.1
CPPFLAGS = -D_WIN32 -DWIN32_LEAN_AND_MEAN -DL_ENDIAN -DHAVE_STDINT_H -DIPv6 -DWITH_RDPSND -DRDPSND_WINMM \
	-DPACKAGE_VERSION=\"$(VERSION)\" -DKEYMAP_PATH=\"keymaps/\"
CFLAGS = -std=gnu99 -O2 -Wall -Wextra
LDFLAGS =
WIN32_SYSTEM_LIBS = -lgnutls -lhogweed -lnettle -ltasn1 -lgmp -liconv \
	-lbcrypt -ladvapi32 -lshell32 -lws2_32 -luser32 -lgdi32 -lole32

WIN32_SYSTEM_LIBS += -lwinmm -lcomctl32

# Keep the upstream 1.9.1 protocol inventory explicit. Platform replacements
# required to link a Windows client will be introduced in later stages.
CORE_SOURCES = tcp.c asn.c iso.c mcs.c secure.c licence.c rdp.c orders.c \
	bitmap.c cache.c rdp5.c channels.c rdpdr.c addin.c rdpdr_devices_win32.c \
	mppc.c pstcache.c lspci.c seamless.c rdpsnd.c rdpsnd_dsp.c rdpsnd_input.c rdpsnd_winmm.c \
	ssl.c utils.c stream.c dvc.c rdpear_win32.c rdpedisp.c cssp.c ntlmssp.c cliprdr.c \
	spnego.c config.c platform.c
SHARED_SOURCES = rdesktop.c win32_ui.c win32_window_geometry.c win32_diagnostics.c win32_session_support.c win32_clipboard.c win32_i18n.c win32_profile.c $(CORE_SOURCES)
SHARED_OBJECTS = $(addprefix $(OBJ_DIR)/,$(SHARED_SOURCES:.c=.o))
CLI_OBJECT = $(OBJ_DIR)/cli_main.o
GUI_SOURCES = win32_gui_main.c win32_gui.c win32_gui_prefs.c
GUI_OBJECTS = $(addprefix $(OBJ_DIR)/,$(GUI_SOURCES:.c=.o))
CONFIG_TEST = $(TEST_OBJ_DIR)/config-test.exe
PLATFORM_TEST = $(TEST_OBJ_DIR)/platform-test.exe
ADDIN_TEST = $(TEST_OBJ_DIR)/addin-test.exe
RDPDR_TEST = $(TEST_OBJ_DIR)/rdpdr-test.exe
RDPEAR_TEST = $(TEST_OBJ_DIR)/rdpear-test.exe
ROP_TEST = $(TEST_OBJ_DIR)/rop-test.exe
KEYMAP_TEST = $(TEST_OBJ_DIR)/keymap-test.exe
TOGGLE_TEST = $(TEST_OBJ_DIR)/toggle-test.exe
CLIPBOARD_TEST = $(TEST_OBJ_DIR)/clipboard-test.exe
WINMM_TEST = $(TEST_OBJ_DIR)/winmm-test.exe
PROFILE_TEST = $(TEST_OBJ_DIR)/profile-test.exe
I18N_TEST = $(TEST_OBJ_DIR)/i18n-test.exe
WINDOW_GEOMETRY_TEST = $(TEST_OBJ_DIR)/window-geometry-test.exe
DIAGNOSTICS_TEST = $(TEST_OBJ_DIR)/diagnostics-test.exe
CACHE_RESET_TEST = $(TEST_OBJ_DIR)/cache-reset-test.exe

# These official 1.9.1 sources remain in-tree and are intentionally deferred
# until their Windows platform implementations are rebuilt.
DEFERRED_PLATFORM_SOURCES = xwin.c xgui.c xkeymap.c ewmhints.c xclip.c \
	ctrl.c scard.c rdpsnd.c \
	rdpsnd_alsa.c rdpsnd_dsp.c rdpsnd_input.c rdpsnd_libao.c \
	rdpsnd_oss.c rdpsnd_pulse.c rdpsnd_sgi.c rdpsnd_sun.c

.PHONY: all preflight directories clean package tests

all: preflight directories $(BIN_DIR)/rdesktop.exe $(BIN_DIR)/rdesktop-gui.exe

$(BIN_DIR)/rdesktop.exe: $(CLI_OBJECT) $(SHARED_OBJECTS) | directories
	$(CC) $(LDFLAGS) -o $@ $^ $(WIN32_SYSTEM_LIBS)

$(BIN_DIR)/rdesktop-gui.exe: $(GUI_OBJECTS) $(SHARED_OBJECTS) | directories
	$(CC) $(LDFLAGS) -mwindows -o $@ $^ $(WIN32_SYSTEM_LIBS)

$(BIN_DIR)/%.dll: | directories
	$(POWERSHELL) -NoProfile -Command "$$tool = (Get-Command '$(CC)').Source; $$source = Join-Path (Split-Path $$tool) '$*.dll'; Copy-Item -LiteralPath $$source -Destination '$(BIN_DIR)/$*.dll' -Force"

preflight:
	@where $(CC) >NUL 2>NUL || (echo ERROR: $(CC) not found on PATH. Add the MinGW-w64 x64 toolchain to PATH or override CC. & exit /B 1)
	@where $(POWERSHELL) >NUL 2>NUL || (echo ERROR: $(POWERSHELL) not found on PATH. Override POWERSHELL if necessary. & exit /B 1)

directories:
	@if not exist "$(OBJ_DIR)" mkdir "$(OBJ_DIR)"
	@if not exist "$(BIN_DIR)" mkdir "$(BIN_DIR)"
	@if not exist "$(PACKAGE_DIR)" mkdir "$(PACKAGE_DIR)"
	@if not exist "$(TEST_OBJ_DIR)" mkdir "$(TEST_OBJ_DIR)"

$(OBJ_DIR)/%.o: %.c | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -c -o $@ $<

tests: preflight directories $(CONFIG_TEST) $(PLATFORM_TEST) $(ADDIN_TEST) $(RDPDR_TEST) $(RDPEAR_TEST) $(ROP_TEST) $(KEYMAP_TEST) $(TOGGLE_TEST) $(CLIPBOARD_TEST) $(WINMM_TEST) $(PROFILE_TEST) $(I18N_TEST) $(WINDOW_GEOMETRY_TEST) $(DIAGNOSTICS_TEST) $(CACHE_RESET_TEST)
	"$(CONFIG_TEST)"
	"$(PLATFORM_TEST)"
	"$(ADDIN_TEST)"
	"$(RDPDR_TEST)"
	"$(RDPEAR_TEST)"
	"$(ROP_TEST)"
	"$(KEYMAP_TEST)"
	"$(TOGGLE_TEST)"
	"$(CLIPBOARD_TEST)"
	"$(WINMM_TEST)"
	"$(PROFILE_TEST)"
	"$(I18N_TEST)"
	"$(WINDOW_GEOMETRY_TEST)"
	"$(DIAGNOSTICS_TEST)"
	"$(CACHE_RESET_TEST)"

$(CONFIG_TEST): tests/config_test.c config.c config.h | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -I. -o $@ tests/config_test.c config.c

$(PLATFORM_TEST): tests/platform_test.c platform.c platform.h | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -Werror -I. -o $@ tests/platform_test.c platform.c $(WIN32_SYSTEM_LIBS)

$(ADDIN_TEST): tests/addin_win32_test.c addin.c | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -Werror -I. -o $@ tests/addin_win32_test.c addin.c -lws2_32

$(RDPDR_TEST): tests/rdpdr_win32_test.c rdpdr_devices_win32.c | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -Werror -I. -o $@ tests/rdpdr_win32_test.c rdpdr_devices_win32.c -lws2_32

$(RDPEAR_TEST): tests/rdpear_win32_test.c rdpear_win32.c | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -Werror -I. -o $@ tests/rdpear_win32_test.c rdpear_win32.c -lws2_32

$(ROP_TEST): test_memblt_rop.c rop_semantics.h | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -Werror -I. -o $@ test_memblt_rop.c

$(KEYMAP_TEST): test_win32_keymap.c win32_keymap.h | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -Werror -I. -o $@ test_win32_keymap.c

$(TOGGLE_TEST): test_win32_toggle_state.c win32_toggle_state.h constants.h | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -Werror -I. -o $@ test_win32_toggle_state.c

$(CLIPBOARD_TEST): test_win32_clipboard.c win32_clipboard_logic.h | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -Werror -I. -o $@ test_win32_clipboard.c

$(WINMM_TEST): test_rdpsnd_winmm.c rdpsnd_winmm_logic.h | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -Werror -I. -o $@ test_rdpsnd_winmm.c -lwinmm

$(PROFILE_TEST): tests/win32_profile_test.c win32_profile.c win32_profile.h config.c config.h | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -I. -o $@ tests/win32_profile_test.c win32_profile.c config.c

$(I18N_TEST): tests/win32_i18n_test.c win32_i18n.c win32_i18n.h | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -Werror -I. -o $@ tests/win32_i18n_test.c win32_i18n.c

$(WINDOW_GEOMETRY_TEST): tests/win32_window_geometry_test.c win32_window_geometry.c win32_window_geometry.h | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -Werror -I. -o $@ tests/win32_window_geometry_test.c win32_window_geometry.c

$(DIAGNOSTICS_TEST): tests/win32_diagnostics_test.c win32_diagnostics.c win32_diagnostics.h | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -Werror -I. -o $@ tests/win32_diagnostics_test.c win32_diagnostics.c

$(CACHE_RESET_TEST): tests/cache_reset_test.c cache.c | directories
	$(CC) $(CPPFLAGS) $(CFLAGS) -Werror -I. -o $@ tests/cache_reset_test.c cache.c

package: preflight directories $(BIN_DIR)/rdesktop.exe $(BIN_DIR)/rdesktop-gui.exe $(BIN_RUNTIME_DLLS)
	"$(POWERSHELL)" -NoProfile -ExecutionPolicy Bypass -File package-win32.ps1 -SourceRoot "." -BinDir "$(BIN_DIR)" -PackageDir "$(PACKAGE_DIR)" -PackageName "rdesktop-$(TARGET_NAME).zip"

clean:
	@if exist "$(TARGET_DIR)" rmdir /S /Q "$(TARGET_DIR)"
